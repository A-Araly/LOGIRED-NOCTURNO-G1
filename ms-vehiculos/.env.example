# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto donde escucha este microservicio (ms-vehiculos usa el 3005).
PORT=3005
# 127.0.0.1 = solo acepta conexiones desde el mismo equipo (el gateway Apache estará en ese mismo equipo)
HOST=127.0.0.1
# Roles válidos de la empresa, separados por comas
ROLES=administrador,despacho,flota

# Base de datos MySQL de este microservicio
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vehiculos_db
DB_USER=vehiculos_user
DB_PASSWORD=una-clave-segura

# Dirección de ms-conductores
CONDUCTORES_URL=http://127.0.0.1:3004

# Debe ser la misma en todos los microservicios del grupo (se comparte por un medio privado)
JWT_SECRET=cambie-esta-frase-por-una-larga-y-secreta